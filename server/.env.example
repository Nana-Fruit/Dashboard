# Copy this file to ".env" and fill in real values. .env is gitignored.

SERVER_PORT=4000

# Firebase service account, as the full JSON key content on a single line
# (Firebase console -> Project settings -> Service accounts -> Generate new
# private key). Used to verify client ID tokens and to read/write Firestore.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Factory-side API (dry-room, etc). Calls go to FACTORY_API_BASE_URL/v1/dry-room/batches
# true  = use local mock fixtures (server/src/mock/*.json), no API calls
# false = call the real Factory API
USE_MOCK_FACTORY=true
FACTORY_API_BASE_URL=https://api-xevp5lwcea-as.a.run.app
FACTORY_API_KEY=your-api-key-here

# Office-side API (sales orders, etc). No real API yet - leave USE_MOCK_OFFICE=true.
USE_MOCK_OFFICE=true
OFFICE_API_BASE_URL=
OFFICE_API_KEY=

CACHE_TTL_SECONDS=60
CLIENT_ORIGIN=http://localhost:5173
