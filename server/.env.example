# Copy this file to ".env" and fill in real values. .env is gitignored.

SERVER_PORT=4000

# true  = use local mock fixtures (server/src/mock/*.json), no API calls
# false = call the real APIs
USE_MOCK=true

# Signs the login JWT. Change to a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h

# Dry-room API (only used when USE_MOCK=false)
EXTERNAL_API_BASE_URL=https://api-xevp5lwcea-as.a.run.app
EXTERNAL_API_KEY=your-api-key-here

CACHE_TTL_SECONDS=60
CLIENT_ORIGIN=http://localhost:5173
