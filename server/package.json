{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env.development src/index.js",
    "prod": "node --watch --env-file=.env.production src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "mock:gen": "node scripts/generate-mock.js && node scripts/generate-mock-office.js && node scripts/generate-mock-online.js && node scripts/generate-mock-factory.js && node scripts/generate-mock-fresh-room.js && node scripts/generate-mock-sort-room.js",
    "provision:users": "node --env-file=.env.development scripts/provision-users.js",
    "migrate:config": "node --env-file=.env.development scripts/migrate-config.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "morgan": "^1.10.0"
  }
}
